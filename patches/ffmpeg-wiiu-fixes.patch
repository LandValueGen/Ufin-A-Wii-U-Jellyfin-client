+++ b/libavcodec/h264_wiiu.c
@@ -25,6 +25,10 @@ static int h264_wiiu_decode_init(AVCodecContext *avctx)
     memRequirement = 0x2200000 + 0x3ff + 0x480000;
 
     decoder = malloc(memRequirement);
